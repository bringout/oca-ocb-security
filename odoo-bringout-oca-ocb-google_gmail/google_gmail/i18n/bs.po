msgstr "Samo administrator može povezati Gmail mail server."

# model: code:addons/google_gmail/models/google_gmail_mixin.py
#, []
msgid "Oops, we could not authenticate you. Please try again later."
msgstr "Ups, nismo vas mogli autentikovati. Molimo pokušajte ponovo kasnije."

# model: code:addons/google_gmail/controllers/main.py
#, []
msgid ""
"Oops, you're creating an authorization to send from %(email_login)s but your"
" address is %(email_server)s. Make sure your addresses match!"
msgstr ""
"Ups, kreirate autorizaciju za slanje sa %(email_login)s ali vaša adresa je "
"%(email_server)s. Provjerite da li se adrese poklapaju!"

